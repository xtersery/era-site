# Cloudflare Pages headers for the transport test — the same rules as vercel.json.
# Copied into dist/ by the Pages build command (kept out of public/, so the Vercel build is unchanged).
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
