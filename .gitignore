.vercel/

# The clinic's original photographs — the SOURCE for scripts/case-assets.sh,
# never referenced by the site. `public/` is copied verbatim into `dist/`, so
# anything here that is committed is published at a public URL.
public/images/*.HEIC
public/images/*.heic
public/images/*.JPG
public/images/specialists/

# Heavy local media that should live in asset storage, not git
public/video/*.mp4
public/video/*.webm
public/video/*.mov
!public/video/.gitkeep

# Playwright output
e2e/__screenshots__/
e2e/.results/

