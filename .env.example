# Sanity CMS — reviews (07 — Отзывы). Copy to `.env.local` and fill in.
# The project id is in ../studio-era/sanity.config.ts; the dataset is `production`.
# Without these the site shows the sample reviews in development and no reviews in production.
# Public by design (compiled into the JS). Every origin that serves the site — the
# production domain(s) and https://*.vercel.app for previews — must be in Sanity's
# CORS origins (sanity.io/manage → API → CORS), or Отзывы stays empty there.
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production

# Reserved — the clinic's Yandex Business profile (not connected; no scraping).
# VITE_YANDEX_BUSINESS_ID=

# Заявка → Telegram (POST /api/lead — server/, api/lead.ts). SERVER ONLY:
# never prefix these with VITE_ (anything VITE_* is compiled into the public JS).
# The bot must be a member of the chat; a group's id starts with -100.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Who may post to /api/lead, comma-separated origins. Production: the site's
# domain(s). Leave unset locally and on preview deployments (= same host only).
LEAD_ALLOWED_ORIGINS=
# Shared by the Cloudflare Pages front (functions/api/lead.ts, a Pages secret)
# and the Vercel Function: with it Vercel trusts the visitor's address the
# front forwards, so rate limiting stays per visitor (server/lead/proxy.ts).
LEAD_PROXY_SECRET=

# Shared rate-limit store for serverless (Vercel). Either naming works — the
# second is what Vercel's Upstash integration sets. Without one, rate limiting
# is OFF on Vercel (logged) and the bot protections carry the endpoint.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
